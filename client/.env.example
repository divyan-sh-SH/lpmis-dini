# Copy to .env and fill in. Only VITE_* vars are available in the frontend (Vite).

# API base URL for the frontend. Omit or leave empty to use relative /api (e.g. on Vercel).
# For local dev with API on port 8000: VITE_API_BASE=http://localhost:8000/api
# VITE_API_BASE=

# Backend (api/) only – do not put secrets used only by the API in VITE_ vars.
# SUPABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
